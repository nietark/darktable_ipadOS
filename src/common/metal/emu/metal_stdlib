// Metal's address spaces and function qualifiers mean nothing on the CPU.
// DTCL_EMU_STRICT maps them to clang address spaces instead, for a
// -fsyntax-only check that catches what Metal rejects, such as passing a
// device pointer where a thread pointer is expected; such a build cannot run
#define kernel
#define thread
#ifdef DTCL_EMU_STRICT
#define device __attribute__((address_space(1)))
#define constant __attribute__((address_space(2)))
#define threadgroup __attribute__((address_space(3)))
#else
#define device
#define constant
#define threadgroup
#endif

